# Private project memory and internal tracker (not for public repos)
.memory/
tracker/

# Binaries (compiled outputs only — not matching the deploy/bordo/ directory)
/bordod
/bordo
/bin/
/dist/

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Build artifacts
/build-out/
*.tar.gz
*.zip

# Editor / OS
.DS_Store
.idea/
*.swp
*.swo
.vscode/settings.json
.vscode/launch.json

# Runtime / secrets
*.env
.env
.env.*
!.env.example
*.pem
*.key

# Local dev overrides
bordo.local.yaml
bordod.local.yaml

# Node
node_modules/
.next/
.nuxt/
dist/
coverage/

# Java (Gradle/Maven output dirs — avoid matching Go's build/ module)
target/
*.class
*.jar
*.war
*.ear
.gradle/
# Match build/ only inside SDK/template subdirectories, not the root Go module
sdk/**/build/
templates/**/build/

# k3s / kubeconfig
kubeconfig.yaml
*.kubeconfig
