# Bordo infrastructure settings
# All secrets (API keys, admin token, base URL) are configured via:
#
#   bordo setup --server http://YOUR_VPS_IP:7401
#
# After first-run setup, update individual settings with:
#
#   bordo config set deepseek_api_key sk-...
#   bordo config set registry_url ghcr.io/your-org

# ── Infrastructure (not secrets) ──────────────────────────────────────────────

# Ports (optional — change only if defaults conflict with existing services)
BORDOD_PORT=7401
AGENT_PORT=7402
CONSOLE_PORT=3000

# Internal service-to-service token (auto-generated by install.sh).
# This is NOT the admin token — it only protects agent→bordod traffic on the
# Docker internal network. Users never need to know or set this manually.
BORDO_INTERNAL_TOKEN=

# ── Advanced overrides (optional) ─────────────────────────────────────────────
# These env vars override the settings stored in the database.
# Leave empty to use what was configured via 'bordo setup'.

# BORDO_AUTH_TOKEN=     # override the admin token
# BORDO_BASE_URL=       # override the public URL
# BORDO_SECRET_KEY=     # override the DB encryption key (use with caution)
# DEEPSEEK_API_KEY=     # override the AI provider key in the agent
# BORDO_REGISTRY=       # override the container registry
