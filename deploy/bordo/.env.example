# ── AI Agent ──────────────────────────────────────────────────────────────────
# DeepSeek API key — get one at https://platform.deepseek.com/api_keys (required)
DEEPSEEK_API_KEY=

# Model override (default: deepseek-chat)
BORDO_LLM_MODEL=

# Completions endpoint override — swap to any OpenAI-compatible provider
# Default: https://api.deepseek.com/chat/completions
BORDO_LLM_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# 32+ char secret used to encrypt the secrets store (AES-256-GCM)
# Generate: openssl rand -hex 32
BORDO_SECRET_KEY=change-this-to-a-real-secret-key-32chars

# ── GitOps ────────────────────────────────────────────────────────────────────
# URL of the desired-state git repo the GitOps reconciler watches.
# Leave empty to disable GitOps reconciliation.
BORDO_GITOPS_REPO=

# ── Container registry ────────────────────────────────────────────────────────
# Registry for built images. Leave empty to load images into the local daemon
# (works on Rancher Desktop for local dev without a registry).
# Examples: ghcr.io/your-org, docker.io/your-user, registry.example.com:5000
BORDO_REGISTRY=

# ── Build templates ───────────────────────────────────────────────────────────
# Path to the golden-path templates directory inside the container.
# The Docker image ships with /templates baked in — only override if mounting
# a custom templates directory from the host.
# BORDO_TEMPLATE_ROOT=/templates

# ── GitHub integration ────────────────────────────────────────────────────────
# Personal access token used by the agent's github_create_repo tool to create
# repos and push scaffolded code. Needs repo scope (or public_repo for public repos).
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Ports (optional overrides) ────────────────────────────────────────────────
BORDOD_PORT=7401
AGENT_PORT=7402
CONSOLE_PORT=3000
