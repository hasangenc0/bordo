# Build frontend (Node.js only used at build time, not at runtime)
FROM node:22-alpine AS frontend-build
WORKDIR /app/frontend
COPY console/frontend/package.json console/frontend/package-lock.json* ./
RUN npm ci --prefer-offline
COPY console/frontend/ .
RUN npm run build

# Runtime — pure nginx:alpine (~25 MB image, no Node.js)
FROM nginx:1.27-alpine
RUN apk add --no-cache gettext  # provides envsubst

COPY --from=frontend-build /app/frontend/dist /usr/share/nginx/html
COPY deploy/bordo/nginx-console.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/bordo/console-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    # Remove default nginx config so our template is the only one
    rm -f /etc/nginx/conf.d/default.conf /etc/nginx/http.d/default.conf

EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
