# Build frontend via the npm workspace root (lockfile lives at console/package-lock.json)
FROM node:22-alpine AS frontend-build
WORKDIR /app
# Workspace root manifest + lockfile
COPY console/package.json console/package-lock.json ./
# Both workspace package.jsons needed so npm ci can resolve them
COPY console/frontend/package.json ./frontend/
COPY console/bff/package.json ./bff/
RUN npm install --prefer-offline --no-audit --no-fund
# Copy frontend source and build
COPY console/frontend/ ./frontend/
RUN npm run build --workspace=frontend

# Runtime — pure nginx:alpine (~25 MB image, no Node.js)
FROM nginx:1.27-alpine
RUN apk add --no-cache gettext  # provides envsubst

COPY --from=frontend-build /app/frontend/dist /usr/share/nginx/html
COPY deploy/bordo/nginx-console.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/bordo/console-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    # Remove default nginx config so our template is the only one
    rm -f /etc/nginx/conf.d/default.conf /etc/nginx/http.d/default.conf

EXPOSE 80
ENTRYPOINT ["/entrypoint.sh"]
