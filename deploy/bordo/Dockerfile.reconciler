FROM golang:1.22-alpine AS build
WORKDIR /workspace

COPY go.work go.work.sum ./

COPY agent/go.mod agent/go.sum ./agent/
COPY build/go.mod build/go.sum ./build/
COPY cli/go.mod cli/go.sum ./cli/
COPY control-plane/go.mod control-plane/go.sum ./control-plane/
COPY fleet/go.mod fleet/go.sum ./fleet/
COPY observe/go.mod observe/go.sum ./observe/
COPY release/go.mod release/go.sum ./release/
COPY scripts/go.mod scripts/go.sum ./scripts/

RUN go work sync

COPY agent/ agent/
COPY build/ build/
COPY cli/ cli/
COPY control-plane/ control-plane/
COPY fleet/ fleet/
COPY observe/ observe/
COPY release/ release/
COPY scripts/ scripts/

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bordo-reconciler ./fleet/bordo-reconciler

# Runtime: the reconciler shells out to kubectl using the pod's in-cluster
# ServiceAccount (no kubeconfig), so kubectl must be present.
FROM alpine:3.20
RUN apk add --no-cache ca-certificates kubectl
COPY --from=build /bordo-reconciler /usr/local/bin/bordo-reconciler
ENTRYPOINT ["bordo-reconciler"]
